# Copy this file to .env and fill in the values.
# Bot token from https://discord.com/developers/applications
TOKEN=your-bot-token-here
# Seconds between feed checks
INTERVAL=3600
# DEBUG, INFO, WARNING or ERROR
LOG-LEVEL=INFO
# Set to 0; the bot flips it to 1 after sending the Christmas greeting
CHRISTMAS_WISH=0
# Added by the bot when an admin runs !sbc (one line per server):
# COMICS-CHANNEL-<server id>=<channel id>
