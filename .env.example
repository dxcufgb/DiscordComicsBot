# Copy this file to .env and fill in the values.

# Bot token from https://discord.com/developers/applications (Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# Seconds between feed checks (minimum 60)
INTERVAL=3600

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Discord user IDs (comma separated) allowed to use the owner-only commands
# (/comics-admin restart, delete, check-now). Defaults to the application owner.
#OWNER_IDS=123456789012345678

# Post a Christmas greeting on Dec 24 (true/false)
CHRISTMAS_GREETING=true

# Allow feed URLs on private/local networks, e.g. a feed hosted on your LAN (true/false)
ALLOW_PRIVATE_FEED_URLS=false

# After the bot is updated to a new version, DM the release notes to the admins of every server
# it is in: admins (server owner + members with the Administrator permission), owner, or off.
UPDATE_NOTIFY=admins

# Without this, "admins" can only reach server owners. To include every Administrator, enable
# "Server Members Intent" under Bot in https://discord.com/developers/applications, then set this
# to true (if it is true but not enabled there, the bot cannot log in).
MEMBERS_INTENT=false
